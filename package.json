{
  "name": "cursor-local",
  "productName": "Cursor Local",
  "version": "0.1.0",
  "description": "复刻 Cursor 核心体验的本地 AI 编程工具（Editor Window + Agents Window）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "screenshot": "node screenshot-run.js",
    "test": "node --test test/*.test.js",
    "test:unit": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=modules/agent.js --test-coverage-include=modules/agent/tools.js --test-coverage-include=modules/config.js --test-coverage-include=modules/session.js --test-coverage-include=store/user-store.js test/*.test.js",
    "test:agent": "node test-agent.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide": "^1.48.0",
    "monaco-editor": "^0.52.0"
  },
  "devDependencies": {
    "electron": "^33.2.0"
  }
}
